---
import { mdxComponents } from '../../../components/mdxComponents/map';
import { type CollectionEntry, getCollection } from 'astro:content';
import { render } from 'astro:content';
import ExternalLink from '../../../components/mdxComponents/ExternalLink.svelte';
import BaseHead from '../../../components/BaseHead.astro';
import Image from '../../../components/mdxComponents/Image.astro';
import { proseClasses } from '../../../utils/proseClasses';

export async function getStaticPaths() {
  const posts = await getCollection('works', ({ data }) => data.publish);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'works'>;
const post = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, heroImage } = post.data;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <!-- LEARN: m-0/p-0 were a page-level <style> block. Preflight already zeroes
       body margin, but stating them keeps the intent legible rather than relying
       on a reset that could change. -->
  <body class="m-0 bg-backgroundcolor p-0">
    <article class={`${proseClasses} mx-auto px-6 py-8`}>
      <h1 class="text-konpeki font-serif">{title}</h1>
      <p class="text-syoro italic text-lg">{description}</p>
      {heroImage && (
        <div class="my-8">
          <Image src={heroImage} alt="" class="w-full h-auto object-cover rounded-lg" loading="eager" />
        </div>
      )}
      <Content components={{ ...mdxComponents, a: ExternalLink }} />
    </article>
  </body>
</html>

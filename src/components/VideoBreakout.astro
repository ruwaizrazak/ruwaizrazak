---
/**
 * LEARN: thin wrapper so VideoBreakout can be used from MDX. A component passed
 * through the components map cannot carry a client:* directive (astro#5853), but
 * an .astro component used in MDX can — so the directive lives here.
 *
 * LEARN: client:load, not client:visible. The old scripts/videoBreakout.ts ran
 * at page load for EVERY breakout regardless of visibility, and the wrapper's
 * height is read from its inline style — with client:visible the height is
 * simply absent until the element scrolls into view, which broke the sizing
 * assertion on chromium. client:load is the faithful equivalent.
 */
import VideoBreakoutIsland from './VideoBreakout.svelte';

interface Props {
  src: string;
  title?: string;
}
const { src, title } = Astro.props;
---

<VideoBreakoutIsland client:load src={src} title={title} />

const filteredMentions = mentionsWithContent.filter((m: WebMention) => {
  const domain = m.url.split('/')[2];
  return !blockList.includes(domain);
});

// LEARN: Deduplicate likes by author photo+name — same person may like via multiple URLs
const uniqueLikes = likesAndReposts.filter(
  (like: WebMention, index: number, self: WebMention[]) =>
    index === self.findIndex(
      (t: WebMention) => t.author.photo === like.author.photo && t.author.name === like.author.name,
    ),
);

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function formatContent(content: string) {
  const cleaned = content.replace(/ruwaizrazak\.com.*/g, '');
  return cleaned.length > 280 ? cleaned.slice(0, 280) + '…' : cleaned;
}

function mentionType(m: WebMention) {
  if (m['wm-property'] === 'in-reply-to') return 'replied';
  if (m['wm-property'] === 'mention-of') return 'mentioned';
  return '';
}

const hasMentions = likesAndReposts.length > 0 || filteredMentions.length > 0;
---

<!-- LEARN: resolver half. Everything above runs at BUILD time in Node — reading
     the cached webmentions JSON, matching this post's URL, applying the spam
     blocklist and deduping likes — and none of it ships to the browser. The
     markup and the Show more/less toggle live in WebmentionsView.svelte.
     LEARN: client:load, not client:visible. The toggle sits below the article, so
     deferring is tempting — but the old script ran at page load, and with
     client:visible the first click on Show more lands before hydration and is
     silently swallowed (two e2e assertions caught exactly that). Correctness
     first; this is a good candidate for the Phase 6 payload pass. -->
{hasMentions && (
  <WebmentionsView
    client:load
    likes={likesAndReposts}
    uniqueLikes={uniqueLikes}
    mentions={filteredMentions}
  />
)}

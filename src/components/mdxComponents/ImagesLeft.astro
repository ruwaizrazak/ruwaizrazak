---
/**
 * LEARN: resolver half — stays .astro because optimizeImage() awaits astro:assets,
 * which a Svelte component cannot do during render. All markup lives in the view.
 * Current uses point at imgur (remote), so they take the passthrough branch.
 */
import ImagesLeftView from './ImagesLeftView.svelte';
import { optimizeImage } from '../../utils/optimizeImage';

interface Props {
  imageSrc: string;
  alt?: string;
  imageWidth?: string;
  imagePercent?: number;
}

const { imageSrc, alt = '', imagePercent = 20 } = Astro.props;
const image = await optimizeImage(imageSrc);
---

<ImagesLeftView image={image} alt={alt} imagePercent={imagePercent}>
  <slot />
</ImagesLeftView>

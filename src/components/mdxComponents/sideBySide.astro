---
/**
 * LEARN: resolver half — see ImagesLeft.astro. optimizeImage() awaits
 * astro:assets, so the two images resolve here and the view renders the result.
 */
import SideBySideView from './SideBySideView.svelte';
import { optimizeImage } from '../../utils/optimizeImage';

interface SideItem {
  imageSrc: string;
  caption: string;
}
interface Props {
  leftItem: SideItem;
  rightItem: SideItem;
}

const { leftItem, rightItem } = Astro.props;
const [leftImage, rightImage] = await Promise.all([
  optimizeImage(leftItem.imageSrc),
  optimizeImage(rightItem.imageSrc),
]);
---

<SideBySideView
  leftItem={{ caption: leftItem.caption, image: leftImage }}
  rightItem={{ caption: rightItem.caption, image: rightImage }}
/>

---
/**
 * Image — resolver half; ImageLightbox.svelte holds the markup and behaviour.
 *
 * LEARN: stays .astro for two reasons at once. astro:assets optimization is
 * async and Astro-only, AND a component passed through the MDX components map
 * cannot carry a client:* directive (astro#5853) — but an .astro component used
 * in MDX can. So this file both resolves the image and mounts the island.
 */
import { optimizeImage, optimizePicture } from '../../utils/optimizeImage';
import { resolveImage } from '../../utils/resolveImage';
import ImageLightbox from './ImageLightbox.svelte';

interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  title?: string;
  description?: string;
  loading?: 'lazy' | 'eager';
  [key: string]: any;
}

const { src, alt, width, height, class: className = 'w-full', title, description } = Astro.props;

const resolved = resolveImage(src);
const isSvg = resolved?.format === 'svg';

// SVGs and remote URLs take the plain <img> path; rasters get AVIF/WebP sources.
const picture = resolved && !isSvg ? await optimizePicture(src) : null;
const image = picture ? null : await optimizeImage(src);

// Lightbox shows the full-size image — the optimized asset URL, or the raw
// string for remote.
const fullSrc = resolved?.src ?? src;
---

<ImageLightbox
  client:visible
  picture={picture}
  image={image}
  fullSrc={fullSrc}
  alt={alt || ''}
  class={className}
  title={title}
  description={description}
  width={width}
  height={height}
/>

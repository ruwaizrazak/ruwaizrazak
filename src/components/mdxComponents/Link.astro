---
/**
 * Link.astro — resolver half of the Link pair.
 *
 * Data flow:
 *   1. Classify the link (external vs internal, skip anchors/mailto/tel)
 *   2. resolveTooltipMeta() fetches title + description and derives favicon/URL
 *   3. buildTooltipHTML() turns that data into an HTML string
 *   4. LinkView.svelte places it in a data-tippy-content attribute
 *   5. Client-side, linkTooltips.ts attaches tippy instances to pick it up
 *
 * LEARN: this stays .astro on purpose. Step 2 is an awaited network fetch, and a
 * Svelte component cannot await during render — so the build-time work lives here
 * and LinkView.svelte receives plain, already-resolved props.
 */
import type { HTMLAttributes } from 'astro/types';
import LinkView from './LinkView.svelte';
import { resolveTooltipMeta } from '../../utils/resolveTooltipMeta';
import { buildTooltipHTML } from '../../utils/buildTooltipHTML';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

// --- Link classification ---
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');

// Astro's HTMLAttributes types href as string | URL | null | undefined,
// so we normalize to a plain string for downstream consumers.
const hrefStr = typeof href === 'string' ? href : '';
const isExternal = hrefStr.startsWith('http');

// Don't fetch tooltip data for fragment links, mailto, or tel URIs
const skipTooltip = !hrefStr || hrefStr.startsWith('#') || hrefStr.startsWith('mailto:') || hrefStr.startsWith('tel:');

// --- Tooltip resolution ---
let tooltipHTML = '';
if (!skipTooltip) {
  const meta = await resolveTooltipMeta(hrefStr, isExternal);
  if (meta) {
    tooltipHTML = buildTooltipHTML({
      title: meta.tooltipTitle,
      description: meta.tooltipDesc,
      favicon: meta.favicon,
      displayUrl: meta.displayUrl,
      isExternal,
    });
  }
}
---

<LinkView href={href} class={className} tooltipHTML={tooltipHTML} isExternal={isExternal} isActive={isActive} {...props}>
  <slot />
</LinkView>

<script>
  // LEARN: kept as ONE delegated module script rather than a Svelte `use:` action.
  // An action only runs in a hydrated component, and a post can carry 9+ links —
  // that would mean 9 islands to do what a single querySelectorAll pass does.
  // Astro dedupes this import across every Link instance on the page.
  import '../../scripts/linkTooltips.ts';
</script>

---
/**
 * LEARN: thin wrapper so the demo can be used from MDX. A component passed
 * through the components map cannot carry a client:* directive (astro#5853), but
 * an .astro component used in MDX can — so the directive lives here.
 *
 * LEARN: client:load, like Webmentions and VideoBreakout. With client:visible the
 * first interaction lands before hydration and is silently swallowed — the e2e
 * suite caught it as "expands and collapses" finding no data-expanded at all.
 * Worth revisiting in the Phase 6 payload pass, but not at the cost of a
 * dropped first tap.
 */
import TocPillDemoView from './TocPillDemoView.svelte';

interface Props {
  headings?: string[];
  caption?: string;
}
const { headings, caption } = Astro.props;
---

<TocPillDemoView client:load headings={headings} caption={caption} />

---
/**
 * LEARN: this is the resolver for the garden family. GardenCards and GardenStrip
 * are Svelte now, so the hero-image optimization (astro:assets) and the
 * build-time random tree choice both happen here.
 */
import Header from '../Header.astro';
import GardenIntro from './GardenIntro.svelte';
import GardenCards from './GardenCards.svelte';
import GardenStrip from './GardenStrip.svelte';
import { optimizeImage } from '../../utils/optimizeImage';
import type { GardenCardProps } from '../../types';

interface Props {
  title: string;
  description: string;
  posts: any[];
  sortedTags: string[];
  layout?: 'grid' | 'garden';
  collection?: string;
}
const { title, description, posts, layout = 'grid', collection } = Astro.props;

const cardVariantCollections = new Set(['essays', 'playground']);
// LEARN: Content entries contain their complete source body. Project only the
// fields the island renders so Astro does not serialize every article into HTML.
const cards: GardenCardProps[] = await Promise.all(
  (posts ?? []).map(async (post) => ({
    id: post.id,
    collection: post.collection,
    title: post.data.title,
    description: post.data.description ?? '',
    pubDate: post.data.pubDate,
    tags: post.data.tags ?? [],
    maturity: post.data.maturity,
    image: await optimizeImage(
      post.collection === 'series'
        ? post.data.featuredImage
        : cardVariantCollections.has(post.collection)
          ? post.data.heroImage
          : undefined,
    ),
    startedDate: post.data.startedDate,
    lastUpdated: post.data.lastUpdated,
    postCount: post.postCount,
    posts: post.data.posts,
  })),
);

// LEARN: chosen here, at build time, so the server and client agree. Picking a
// random tree inside the component would make SSR and hydration disagree.
const TREE_COUNT = 23;
const treeIndices = Array.from({ length: 8 }, () => Math.floor(Math.random() * TREE_COUNT));
---

<!-- Keep page chrome aligned without making fixed/full-width surfaces inherit
     the page gutter. The dropdown's shadow clip also stays inside the viewport. -->
<div class="px-5 md:px-20">
  <Header />
</div>
<main class="px-5 md:px-20">
  <GardenIntro title={title} description={description} collection={collection} />
  <!-- LEARN: client:visible — the cascade is an entrance animation, so there is
       nothing to do until the grid is on screen. -->
  <GardenCards client:visible cards={cards} layout={layout} />
</main>
<!-- LEARN: client:load — the strip is position:fixed at the bottom of the
     viewport, so it is visible from first paint and its scroll trigger has to be
     live immediately. -->
<GardenStrip client:load treeIndices={treeIndices} />

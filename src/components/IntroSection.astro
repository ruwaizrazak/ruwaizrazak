---
/**
 * LEARN: resolver half. The Nordeus link carries a build-time tooltip, and
 * resolveTooltipMeta() is an awaited network fetch — unreachable from Svelte.
 * Resolve here, render the markup in IntroSectionView.svelte.
 */
import IntroSectionView from './IntroSectionView.svelte';
import { resolveTooltipMeta } from '../utils/resolveTooltipMeta';
import { buildTooltipHTML } from '../utils/buildTooltipHTML';

const NORDEUS = 'https://nordeus.com/';
const meta = await resolveTooltipMeta(NORDEUS, true);
const nordeusTooltip = meta
  ? buildTooltipHTML({
      title: meta.tooltipTitle,
      description: meta.tooltipDesc,
      favicon: meta.favicon,
      displayUrl: meta.displayUrl,
      isExternal: true,
    })
  : '';
---

<IntroSectionView nordeusTooltip={nordeusTooltip} />

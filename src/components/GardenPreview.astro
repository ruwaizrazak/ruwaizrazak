---
/**
 * LEARN: resolver half — optimizeImage() awaits astro:assets, which a Svelte
 * component cannot do during render. All markup lives in GardenPreviewView.svelte.
 */
import GardenPreviewView from './GardenPreviewView.svelte';
import { optimizeImage } from '../utils/optimizeImage';

interface Props {
  posts: any[];
}

const { posts } = Astro.props;
// LEARN: Defensive filter — this block is essays-only even if a parent passes more
const essays = posts.filter((post) => post.collection === 'essays');
const cards = await Promise.all(
  essays.map(async (post) => ({ post, image: await optimizeImage(post.data.heroImage) })),
);
---

<GardenPreviewView cards={cards} pathname={Astro.url.pathname} />

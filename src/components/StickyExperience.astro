---
/**
 * LEARN: resolver half. Each entry needs two things a Svelte component cannot do:
 * an astro:assets optimization for the company logo, and an awaited
 * resolveTooltipMeta() fetch for the website link. Both happen here; the markup
 * lives in StickyExperienceView.svelte.
 */
import StickyExperienceView from './StickyExperienceView.svelte';
import { optimizeImage } from '../utils/optimizeImage';
import { resolveTooltipMeta } from '../utils/resolveTooltipMeta';
import { buildTooltipHTML } from '../utils/buildTooltipHTML';

interface ExperienceEntry {
  role: string;
  company: string;
  period: string;
  website: URL;
  bullets: string[];
  image: URL;
}

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;

const resolved = await Promise.all(
  entries.map(async (entry) => {
    const href = String(entry.website);
    const meta = await resolveTooltipMeta(href, true);
    return {
      role: entry.role,
      company: entry.company,
      period: entry.period,
      website: href,
      bullets: entry.bullets,
      logo: await optimizeImage(String(entry.image)),
      websiteTooltip: meta
        ? buildTooltipHTML({
            title: meta.tooltipTitle,
            description: meta.tooltipDesc,
            favicon: meta.favicon,
            displayUrl: meta.displayUrl,
            isExternal: true,
          })
        : '',
    };
  }),
);
---

<StickyExperienceView entries={resolved} />

<script>
  // LEARN: whatever RENDERS a tooltip must also load the binder. Link.astro does
  // this too. It matters because these resolver shells emit data-tippy-content
  // through LinkView.svelte without going through Link.astro — so when Footer and
  // IntroSection stopped rendering Link.astro, the homepage kept its tooltip
  // markup but lost the script that binds it, silently. Astro dedupes the import.
  import '../scripts/linkTooltips.ts';
</script>

---
/**
 * LEARN: this stays .astro purely as the island's mount point — layouts import it
 * and it applies client:visible. It no longer resolves anything async: the page
 * links used to carry build-time tooltips via resolveTooltipMeta(), which the
 * redesign drops for a numbered index. That also closes a latent bug — this file
 * rendered tooltip markup but never imported scripts/linkTooltips.ts, so the
 * binder was missing and those tooltips could not have worked.
 */
import { SOCIAL_LINKS } from '../consts';
import FooterView from './FooterView.svelte';

const PAGE_LINKS = [
  { href: '/', label: 'Home' },
  { href: '/garden', label: 'Garden' },
  { href: '/about', label: 'About' },
  { href: '/works', label: 'Works' },
  { href: '/series', label: 'Series' },
  { href: '/playground', label: 'Playground' },
  { href: '/live', label: 'Live' },
];

// The data-contact attribute drives GA4's contact_click event.
const CONTACT_BY_LABEL: Record<string, string> = {
  LinkedIn: 'linkedin',
  Email: 'email',
  GitHub: 'github',
};
const socialLinks = SOCIAL_LINKS.map((link) => ({
  ...link,
  contact: CONTACT_BY_LABEL[link.label],
}));
---

<FooterView client:visible socialLinks={socialLinks} pageLinks={PAGE_LINKS} />

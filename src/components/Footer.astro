---
/**
 * LEARN: resolver half. Each page link carries a build-time tooltip, and
 * resolveTooltipMeta() is an awaited network fetch — unreachable from Svelte.
 * Resolve here; FooterView.svelte renders and owns the hover morph.
 */
import { SOCIAL_LINKS } from '../consts';
import FooterView from './FooterView.svelte';
import { resolveTooltipMeta } from '../utils/resolveTooltipMeta';
import { buildTooltipHTML } from '../utils/buildTooltipHTML';

const PAGE_LINKS = [
  { href: '/', label: 'Home' },
  { href: '/garden', label: 'Garden' },
  { href: '/about', label: 'About' },
  { href: '/works', label: 'Works' },
  { href: '/series', label: 'Series' },
  { href: '/playground', label: 'Playground' },
  { href: '/live', label: 'Live' },
];

const pageLinks = await Promise.all(
  PAGE_LINKS.map(async (link) => {
    const meta = await resolveTooltipMeta(link.href, false);
    return {
      ...link,
      tooltipHTML: meta
        ? buildTooltipHTML({
            title: meta.tooltipTitle,
            description: meta.tooltipDesc,
            favicon: meta.favicon,
            displayUrl: meta.displayUrl,
            isExternal: false,
          })
        : '',
    };
  }),
);

// The data-contact attribute drives GA4's contact_click event.
const CONTACT_BY_LABEL: Record<string, string> = {
  LinkedIn: 'linkedin',
  Email: 'email',
  GitHub: 'github',
};
const socialLinks = SOCIAL_LINKS.map((link) => ({
  ...link,
  contact: CONTACT_BY_LABEL[link.label],
}));
---

<FooterView client:visible socialLinks={socialLinks} pageLinks={pageLinks} />

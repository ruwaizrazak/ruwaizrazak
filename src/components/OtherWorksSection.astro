---
/**
 * LEARN: resolver half — getCollection() and the hero-image optimization inside
 * toWorkCardsCompact() both need the Astro side. The island only renders.
 */
import { getCollection } from 'astro:content';
import OtherWorksSectionView from './OtherWorksSectionView.svelte';
import { toWorkCardsCompact } from '../utils/workCards';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const otherWorks = (await getCollection('works', ({ data }) => data.publish)).filter(
  (entry) => entry.id !== currentSlug
);
const otherCards = await toWorkCardsCompact(otherWorks);
---

<OtherWorksSectionView client:visible cards={otherCards} />

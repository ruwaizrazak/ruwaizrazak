---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE, GA_ID } from '../consts';
import { Font } from 'astro:assets';
interface Props {
	title: string;
	description: string;
	image?: string;
	// LEARN: Optional JSON-LD for page-specific structured data (e.g. BlogPosting).
	// BaseHead always emits a WebSite+Person schema; this adds a second block.
	schema?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// LEARN: The default OG image fallback is used for pages that don't pass an
// explicit image prop (e.g., the homepage, about page). The avatar serves as
// a recognisable brand marker when no content-specific OG image exists.
const { title, description, image = '/avatar.jpg', schema } = Astro.props;

// LEARN: JSON-LD helps search engines understand who owns the site (Person)
// and what it is (WebSite), improving rich results and Knowledge Graph entries
const siteSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${Astro.site}#website`,
			url: Astro.site,
			name: SITE_TITLE,
		},
		{
			'@type': 'Person',
			'@id': `${Astro.site}#person`,
			name: 'Ruwaiz Razak',
			url: Astro.site,
			sameAs: [
				'https://mastodon.social/@ruwaizrazak',
				'https://bsky.app/profile/ruwaizrazak.com',
				'https://www.linkedin.com/in/ruwaizrazak/',
				'https://github.com/ruwaizrazak',
			],
		},
	],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="keywords" content="Designer | Prototyper ">
<meta name="author" content="Ruwaiz Razak">
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<!-- LEARN: records which way the reader is travelling so a view transition can
     tell "opening" from "going back". Astro sets its own data-astro-transition,
     but only for ~16ms (measured: set at 11ms, removed at 27ms) — far shorter
     than a 400ms animation, so scoping CSS to it would cut the animation short.
     This attribute persists until the next navigation instead. Written to the
     INCOMING document so it is already present when the swap lands — setting it
     after the swap leaves a ~13ms window where the attribute is absent.
     Registered once; document listeners survive ClientRouter swaps. -->
<script is:inline>
  if (!window.__navDirection) {
    window.__navDirection = 1;
    var dir = 'forward';
    document.addEventListener('astro:before-preparation', function (e) { dir = e.direction || 'forward'; });
    document.addEventListener('astro:before-swap', function (e) { e.newDocument.documentElement.dataset.navDirection = dir; });
  }
</script>

<script is:inline>
  (function() {
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const shouldBeDark = stored === 'dark' || (stored !== 'light' && prefersDark);
    if (shouldBeDark) document.documentElement.classList.add('dark');
  })();
</script>
<meta name="fediverse:creator" content="@ruwaizrazak@mastodon.social">

<!-- IndieWeb: identity verification for IndieAuth -->
<link rel="me" href="https://mastodon.social/@ruwaizrazak" />
<link rel="me" href="https://bsky.app/profile/ruwaizrazak.com" />

<!-- Webmention endpoints (webmention.io) -->
<link rel="webmention" href="https://webmention.io/ruwaizrazak.com/webmention" />
<link rel="pingback" href="https://webmention.io/ruwaizrazak.com/xmlrpc" />

<link rel="icon" type="image/ico" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- JSON-LD structured data -->
<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

<!-- LEARN: <Font> inlines this family's @font-face rules; preload is limited to the LCP faces
     (body serif, heading sans), since preloading every weight would compete with the page. -->
<Font cssVariable="--font-plex-serif" preload={[{ weight: 400, style: 'normal' }]} />
<Font cssVariable="--font-saira-condensed" preload={[{ weight: 500, style: 'normal' }]} />
<Font cssVariable="--font-plex-mono" />
<Font cssVariable="--font-caveat" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- LEARN: gtag.js (~168 KB) is injected after the load event, when the browser is idle, so it never
     competes with first paint. window.gtag must be global: analytics.ts calls it for custom events. -->
<script define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { dataLayer.push(arguments); };
  gtag('js', new Date());
  gtag('config', GA_ID);
  addEventListener('load', () => (window.requestIdleCallback || setTimeout)(() => {
    const s = document.createElement('script');
    s.async = true; s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.append(s);
  }), { once: true });
</script>

# Plans stay on disk — the Codex toolkit resolves them from PLAN_DIR — but out of git.
# Note: the four plans committed before this rule (tailwind-*, scroll-restoration-*) are already
# tracked, and an ignore rule does not untrack them. `git rm --cached docs/plans/<file>` would.
docs/plans/
